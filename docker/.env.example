# Environment variables for Docker Compose

# Database Configuration
DB_USER=pole_user
DB_PASSWORD=pole_password
DB_NAME=pole_ai_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Frontend
FRONTEND_PORT=4200

# Backend
BACKEND_PORT=8000

# Database Port
DB_PORT=5432

# LLM Configuration (Trainingsplan-Generierung)
# Provider: ollama (lokal, Standard) | openai (OpenAI oder kompatibel, z. B. LM Studio) | anthropic (Claude)
LLM_PROVIDER=ollama
# Leer lassen = Standardmodell des Providers (ollama: llama3.1:8b)
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=2

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI / OpenAI-kompatibel (für LM Studio z. B. http://localhost:1234/v1, Key leer lassen)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_JSON_MODE=true

# Anthropic
ANTHROPIC_API_KEY=
