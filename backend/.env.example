# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pole_ai_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ML Model Configuration
MODEL_PATH=./models/pole_trainer_model
MODEL_NAME=pole-training-generator

# LLM Configuration (Trainingsplan-Generierung)
# Provider: ollama (lokal, Standard) | openai (OpenAI oder kompatibel, z. B. LM Studio) | anthropic (Claude)
LLM_PROVIDER=ollama
# Leer lassen = Standardmodell des Providers (ollama: llama3.1:8b)
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=2

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Kontextfenster in Tokens für Trainingspläne (leer = Ollama-Standard, oft 4096)
OLLAMA_NUM_CTX=

# OpenAI / OpenAI-kompatibel (für LM Studio z. B. http://localhost:1234/v1, Key leer lassen)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_JSON_MODE=true

# Anthropic
ANTHROPIC_API_KEY=

# Video-Analyse (Ausführungs-Feedback) – braucht ein Vision-Modell
# Leer lassen = LLM_PROVIDER verwenden. Modell leer = Vision-Standard des Providers
# (ollama: qwen2.5vl:7b, openai: gpt-4o-mini, anthropic: claude-sonnet-5-5)
VISION_LLM_PROVIDER=
# Exakt der Name aus `ollama list`, z. B. qwen2.5vl:latest oder llama3.2-vision:latest
VISION_LLM_MODEL=
VISION_LLM_TIMEOUT_SECONDS=300
# Kontextfenster für Ollama bei der Videoanalyse (Bilder brauchen viele Tokens, ~300-500 pro Frame).
# Mehr Kontext = mehr (V)RAM. Bei Speicherproblemen: weniger Frames oder VIDEO_FRAME_MODE=grid
VISION_OLLAMA_NUM_CTX=16384
# Anzahl Keyframes pro Video (Standard / Maximum)
VIDEO_NUM_FRAMES=8
VIDEO_MAX_FRAMES=16
# Längste Bildkante der Frames in Pixeln (kleiner = weniger Tokens)
VIDEO_FRAME_MAX_SIDE=768
# frames = einzelne Bilder | grid = ein Kontaktbogen (weniger Tokens, weniger Details)
VIDEO_FRAME_MODE=frames
# Optionale Pose-Schätzung mit MediaPipe (pip install mediapipe)
VIDEO_POSE_ESTIMATION=false
VIDEO_MAX_UPLOAD_MB=200
# OpenAI: Bilddetail low | high | auto
OPENAI_IMAGE_DETAIL=auto

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=INFO
